@model List<UserInRoleDto>
@{
    Layout = null;
    ViewData["Title"] = "AddOrRemoveUsers";
    var RoleId = @ViewData["RoleId"] as string;
}

<h3>@ViewData["RoleName"] Role</h3>



    @for(int i = 0; i < Model.Count; i++)
    {
        <div style="align-items: center; display: flex; gap: 10px;">
            <input asp-for="@Model[i].IsSelected" class="form-check-input" />
            <label asp-for="@Model[i].IsSelected" class="col-form-label fs-5">@Model[i].UserName</label>
            @* <span asp-validation-for="@Model[i].IsSelected" class="text-danger"></span> *@
        </div>
        <input asp-for="@Model[i].UserId" type="hidden" />
        <input asp-for="@Model[i].UserName" type="hidden" />

    }


