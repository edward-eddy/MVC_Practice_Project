@model IEnumerable<RoleDto>
@{
    ViewData["Title"] = "Index";
    var ViewDataMessage = ViewData["Message02"];
}

<h1>All Roles</h1>

<br />


@if (!string.IsNullOrEmpty(TempData["Popup"] as string))
{
    <div id="addPop" class="mx-3 alert alert-success">
        <p>
            @TempData["Popup"]
        </p>
    </div>
}

@* <script>setTimeout(()=>{@TempData["Popup"] = ""}, 1000)</script> *@

<form method="get" class="mb-3 container">
    <div class="row flex justify-content-between">
        <input name="SearchInput" class="flex-column col-8 " route="Role" id="SearchInput" asp-for="@ViewData["SearchInput"]" placeholder="Search By Name" />
        <input type="submit" class="btn btn-success flex-column col-1" value="Search" />
        <div class="col-2"></div>
    </div>
</form>

<a asp-action="Create" asp-controller="Role" class="btn btn-primary">Add New Role</a>


<br />
<br />

@if (Model.Any())
{
    <div id="TableContainer">
        <table class="table table-hover table-striped table-light">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Details</th>
                    <th>Update</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <tbody>

                @foreach (var role in Model)
                {
                    <tr>
                        <td>@role.Id</td>
                        <td>@role.Name</td>
                        <td><a class="btn btn-success" asp-route-id="@role.Id" asp-action="Details">Details</a></td>
                        <td><a class="btn btn-warning" asp-route-id="@role.Id" asp-action="Edit">Update</a></td>
                        <td><a class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#role-@role.Id">Delete</a></td>

                    </tr>
                    <!-- Modal -->
                    <div class="modal fade" id="role-@role.Id" tabindex="-1" aria-labelledby="Label-role-@(role.Id)" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h1 class="modal-title fs-5" id="Label-role-@(role.Id)">Warning</h1>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    Are You Sure You Want To Delete <strong>@role.Name</strong>?
                                    <br />
                                    You Can't Undo This Action
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                    <form>
                                        <button type="submit" asp-route-id="@role.Id" asp-action="Delete" class="delete btn btn-danger">Delete Employee</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </tbody>
        </table>
    </div>
}

else
{
    <div id="TableContainer">
        <div class="mt-4 alert alert-warning">
            <h4>
                There Is No Roles :(
            </h4>
        </div>
    </div>

}
<script src="~/js/SearchByName.js"></script>